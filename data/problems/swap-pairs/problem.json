{
  "slug": "swap-pairs",
  "title": "Swap adjacent pairs",
  "prompt": "Return a new list where each pair of adjacent items is swapped: [1, 2, 3, 4] becomes [2, 1, 4, 3]. A final unpaired item stays in place.",
  "entry_point": "swap_pairs",
  "concepts": [
    "arrays",
    "indexing",
    "loops"
  ],
  "public_tests": [
    {
      "label": "Even length",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": [
        2,
        1,
        4,
        3
      ]
    },
    {
      "label": "Two items",
      "args": [
        [
          "a",
          "b"
        ]
      ],
      "expected": [
        "b",
        "a"
      ]
    },
    {
      "label": "Empty",
      "args": [
        []
      ],
      "expected": []
    }
  ],
  "hidden_tests": [
    {
      "label": "Odd length",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": [
        2,
        1,
        3
      ]
    },
    {
      "label": "Single item",
      "args": [
        [
          9
        ]
      ],
      "expected": [
        9
      ]
    }
  ],
  "wrong_solution": {
    "mistake_type": "index_or_key",
    "explanation": "The range reaches the last index, so result[i + 1] raises IndexError on odd lengths."
  }
}
