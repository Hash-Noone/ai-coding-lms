{
  "slug": "sum-of-evens",
  "title": "Sum of even numbers",
  "prompt": "Return the sum of the even integers in `numbers`. Return 0 for an empty list.",
  "entry_point": "sum_evens",
  "concepts": [
    "loops",
    "operators"
  ],
  "public_tests": [
    {
      "label": "Mixed numbers",
      "args": [
        [
          1,
          2,
          3,
          4
        ]
      ],
      "expected": 6
    },
    {
      "label": "No evens",
      "args": [
        [
          1,
          3,
          5
        ]
      ],
      "expected": 0
    },
    {
      "label": "Empty list",
      "args": [
        []
      ],
      "expected": 0
    }
  ],
  "hidden_tests": [
    {
      "label": "Negative evens",
      "args": [
        [
          -2,
          -3,
          4
        ]
      ],
      "expected": 2
    },
    {
      "label": "Zero is even",
      "args": [
        [
          0,
          7
        ]
      ],
      "expected": 0
    }
  ],
  "wrong_solution": {
    "mistake_type": "condition_logic",
    "explanation": "Tests for odd numbers instead of even ones."
  }
}
