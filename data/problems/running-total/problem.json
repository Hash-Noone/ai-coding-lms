{
  "slug": "running-total",
  "title": "Running total",
  "prompt": "Return a list where each element is the sum of `numbers` up to and including that position.",
  "entry_point": "running_total",
  "concepts": [
    "arrays",
    "loops",
    "variables"
  ],
  "public_tests": [
    {
      "label": "Counting up",
      "args": [
        [
          1,
          2,
          3
        ]
      ],
      "expected": [
        1,
        3,
        6
      ]
    },
    {
      "label": "Single item",
      "args": [
        [
          5
        ]
      ],
      "expected": [
        5
      ]
    },
    {
      "label": "Empty",
      "args": [
        []
      ],
      "expected": []
    }
  ],
  "hidden_tests": [
    {
      "label": "Negatives",
      "args": [
        [
          2,
          -2,
          4
        ]
      ],
      "expected": [
        2,
        0,
        4
      ]
    },
    {
      "label": "Zeros",
      "args": [
        [
          0,
          0
        ]
      ],
      "expected": [
        0,
        0
      ]
    }
  ],
  "wrong_solution": {
    "mistake_type": "state_management",
    "explanation": "Resets the total inside the loop."
  }
}
