{
  "slug": "remove-duplicates",
  "title": "Remove duplicates",
  "prompt": "Return a new list with duplicates removed from `items`, keeping the first occurrence of each value in its original order.",
  "entry_point": "dedupe",
  "concepts": [
    "hashing",
    "arrays"
  ],
  "public_tests": [
    {
      "label": "Simple repeats",
      "args": [
        [
          1,
          2,
          2,
          3
        ]
      ],
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "label": "No repeats",
      "args": [
        [
          4,
          5
        ]
      ],
      "expected": [
        4,
        5
      ]
    },
    {
      "label": "Empty",
      "args": [
        []
      ],
      "expected": []
    }
  ],
  "hidden_tests": [
    {
      "label": "Order matters",
      "args": [
        [
          3,
          1,
          3,
          2,
          1
        ]
      ],
      "expected": [
        3,
        1,
        2
      ]
    },
    {
      "label": "Strings",
      "args": [
        [
          "b",
          "a",
          "b"
        ]
      ],
      "expected": [
        "b",
        "a"
      ]
    }
  ],
  "wrong_solution": {
    "mistake_type": "edge_case",
    "explanation": "A set does not keep the original order."
  }
}
