{
  "slug": "vowel-positions",
  "title": "Vowel positions",
  "prompt": "Return a list of the indexes in `word` where a lowercase vowel (a, e, i, o, u) appears.",
  "entry_point": "vowel_positions",
  "concepts": [
    "strings",
    "indexing",
    "loops"
  ],
  "public_tests": [
    {
      "label": "Simple word",
      "args": [
        "banana"
      ],
      "expected": [
        1,
        3,
        5
      ]
    },
    {
      "label": "No vowels",
      "args": [
        "xyz"
      ],
      "expected": []
    },
    {
      "label": "All vowels",
      "args": [
        "aei"
      ],
      "expected": [
        0,
        1,
        2
      ]
    }
  ],
  "hidden_tests": [
    {
      "label": "Empty",
      "args": [
        ""
      ],
      "expected": []
    },
    {
      "label": "Vowel at end",
      "args": [
        "shoe"
      ],
      "expected": [
        2,
        3
      ]
    }
  ],
  "wrong_solution": {
    "mistake_type": "name_resolution",
    "explanation": "Misspells the parameter name."
  }
}
